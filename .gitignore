# ── macOS ───────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*

# ── Xcode (project is generated by XcodeGen from project.yml) ───────────────
*.xcodeproj/
*.xcworkspace/
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
*.moved-aside
DerivedData/
/build/
*.hmap
*.ipa
*.dSYM
*.dSYM.zip
timeline.xctimeline
playground.xcworkspace

# ── Generated by XcodeGen from project.yml (edit project.yml, not these) ────
/VoxFlow/Info.plist

# ── Swift Package Manager ───────────────────────────────────────────────────
.build/
.swiftpm/
spikes/**/.build/
# No Package.resolved is generated: the package has no source-control dependencies; the
# XCFramework is pinned by its checksum in Package.swift.

# ── Test output ─────────────────────────────────────────────────────────────
*.xcresult
TestResults/
*.profraw
*.profdata
*.log

# ── Models and media (downloaded at runtime, never committed) ───────────────
# Speech/LLM model files live in ~/Library/Application Support/VoxFlow/Models, not in the repo.
*.bin
*.gguf
*.mlmodelc
*.mlpackage
# Test fixtures under any Fixtures/ directory are tracked; keep each under 1 MB (review checks this).

# ── Signing, secrets, local config ──────────────────────────────────────────
*.p12
*.p8
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile
AuthKey_*.p8
.env
.env.*
*.local.json
ExportOptions.local.plist

# ── Tooling ─────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.swiftlint-cache/
